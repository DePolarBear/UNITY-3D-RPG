  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f5bfba4a2555a947a0298bfe2f9ddbd, type: 3}
  m_Name: Dialog_Vela
  m_EditorClassIdentifier: Assembly-CSharp::DialogAsset
  meno: Vela
  uzly:
  - text: Zvon uz dva mesiace nezvonil. Nemam silu vytiahnut lano.
    odpovede:
    - text: Preco na tom zalezi?
      kamVedie: 1
    - text: Pomozem vam.
      kamVedie: 2
  - text: Zvon volal ludi z poli, ked prisla burka. Teraz ich nikto nevola.
    odpovede:
    - text: Pomozem vam s nim.
      kamVedie: 2
    - text: Chapem.
      kamVedie: -1
  - text: Si dobry clovek. Vystup do veze, ked budes mat cas.
    odpovede:
    - text: Spravim to.
      kamVedie: -1
