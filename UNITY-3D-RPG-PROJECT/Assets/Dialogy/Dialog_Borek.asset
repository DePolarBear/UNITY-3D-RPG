  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f5bfba4a2555a947a0298bfe2f9ddbd, type: 3}
  m_Name: Dialog_Borek
  m_EditorClassIdentifier: Assembly-CSharp::DialogAsset
  meno: Borek
  uzly:
  - text: Pila stoji. Drevo z juhu uz tyzden nikto nedoviezol.
    odpovede:
    - text: Co sa stalo?
      kamVedie: 1
    - text: Smola.
      kamVedie: -1
  - text: Cesta je zavalena. Skala spadla po tej burke.
    odpovede:
    - text: Kto to odprace?
      kamVedie: 2
    - text: Uvidime.
      kamVedie: -1
  - text: Nikto. Kazdy caka, ze to spravi ten druhy.
    odpovede:
    - text: Pozriem sa na tu cestu.
      kamVedie: -1
